# ==============================================================
# Athar Khatma API — Production / Render environment checklist
# ==============================================================
# On Render these values are set in the Dashboard (or via render.yaml
# with `sync: false`). This file documents every variable needed.
# NEVER commit real secrets — only this example is tracked.

APP_NAME="Athar Khatma API"
APP_ENV=production
# Generate: php artisan key:generate --show
APP_KEY=
# IMPORTANT: APP_DEBUG must be false in production
APP_DEBUG=false
# Your Render service URL, e.g. https://athar-api.onrender.com
APP_URL=https://athar-api.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs go to Render's log stream
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database: Supabase PostgreSQL (Session pooler, port 5432, IPv4) ---
DB_CONNECTION=pgsql
# Easiest — paste the full connection string from
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_URL=
# Alternative to DB_URL (only if you prefer discrete vars):
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SSLMODE=require

# Sessions / cache / queue tables live in the same Postgres DB
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail: Resend ---
MAIL_MAILER=resend
RESEND_API_KEY=
# Until a domain is verified, Resend's test sender only delivers
# to the account owner (azizabdullahnoor@gmail.com).
# After verifying your domain at https://resend.com/domains,
# switch this to noreply@yourdomain.com to reach all users.
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="ختمة وأثر"

# --- Frontend / CORS (must match the deployed client origin) ---
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
SANCTUM_STATEFUL_DOMAINS=your-frontend.vercel.app

# --- Auth ---
SANCTUM_TOKEN_EXPIRATION=60

# --- Misc ---
VITE_APP_NAME="${APP_NAME}"
GOOGLE_MAPS_API_KEY=

