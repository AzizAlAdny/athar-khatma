APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# IMPORTANT: Set APP_DEBUG=false in production environments
# For local development, you can set APP_DEBUG=true
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email Configuration
# Production: SMTP — configure SMTP settings below
# Local dev without a mailer: MAIL_MAILER=log (writes emails to the log file)
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="Khatmaweb@gmail.com"
MAIL_FROM_NAME="ختمة وأثر"

# SMTP Configuration (configure in Render environment variables)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="Khatmaweb@gmail.com"
MAIL_PASSWORD=your_app_password_here
MAIL_ENCRYPTION=tls
MAIL_SCHEME=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_MAPS_API_KEY=

# Admin User Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=SecureAdminPassword123!

# Seed User Password (for demo data)
SEED_PASSWORD=SecureDemoPassword123!

# Sanctum Token Expiration (in minutes)
SANCTUM_TOKEN_EXPIRATION=60

# Sanctum Stateful Domains (first-party SPA origins for cookie-based auth)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000,::1

# CORS Allowed Origins (comma-separated; must match the frontend domain(s))
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL (used for email verification links and CORS defaults)
FRONTEND_URL=http://localhost:3000
