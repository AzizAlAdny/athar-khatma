# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Application Configuration
NEXT_PUBLIC_APP_NAME=ختمة وأثر
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Maps API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Real-Time WebSockets (Pusher / Reverb)
NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_APP_CLUSTER=mt1
NEXT_PUBLIC_PUSHER_SCHEME=https

# WebRTC TURN relay (optional, but strongly recommended in production).
# Needed when both users are behind symmetric NAT / mobile data, where STUN
# alone cannot open an audio path. The URL can be a comma-separated list.
# NEXT_PUBLIC_TURN_URL=turn:your-turn-server:3478,turns:your-turn-server:443
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
